# Copy this file to .env and fill in real values. Never commit .env.

# --- Supabase (PostgreSQL + Storage) ---
# Percent-encode special characters in the database password (e.g. @ -> %40).
# Session Pooler (port 5432): used by `prisma migrate`.
DIRECT_URL=
# Transaction Pooler (port 6543) with ?pgbouncer=true: the app's runtime connection.
SUPABASE_DATABASE_URL=
SUPABASE_URL=
# Server-only secret key. Never prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SECRET_KEY=

# --- Meta WhatsApp Business Cloud API ---
# Permanent system-user access token (Business Messaging permission).
WHATSAPP_ACCESS_TOKEN=
# The registered business phone number's Phone Number ID.
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business Account ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional — defaults shown below if unset.
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=booking_confirmation
# Must match the template's language exactly as registered in Meta — check
# WhatsApp Manager > Message Templates if unsure (often "en", not "en_US").
WHATSAPP_TEMPLATE_LANGUAGE=en
